# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database (SQLite by default; PostgreSQL recommended for production)
# ---------------------------------------------------------------------------
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=schoolerp
# DB_USER=schoolerp
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=require

# ---------------------------------------------------------------------------
# JWT / auth
# ---------------------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
AUTH_COOKIE_SECURE=False
ALLOW_PUBLIC_REGISTRATION=False

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Internationalisation
# ---------------------------------------------------------------------------
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Dhaka

# ---------------------------------------------------------------------------
# Email (console in development)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=School ERP <no-reply@school.example>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# ---------------------------------------------------------------------------
# Reverse proxy (only enable when a trusted proxy sets X-Forwarded-For)
# ---------------------------------------------------------------------------
USE_X_FORWARDED_FOR=False
